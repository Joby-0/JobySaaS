{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ReferenceDb.db"
  },
  "JwtConfig": {
    "LifeTimeMinutes": 60,
    "ValidateIssuerSigningKey": true,
    "IssuerSigningKey": "SuperSecureReferenceKeyThatShouldBeChanged",
    "ValidateIssuer": true,
    "ValidIssuer": "ApiReference",
    "ValidateAudience": true,
    "ValidAudience": "ApiReferenceAudience",
    "RequireExpirationTime": true,
    "ValidateLifetime": true
  }
}
